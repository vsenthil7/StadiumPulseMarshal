# Copy to backend/.env and fill in to enable live mode. Leave unset for mocks.
USE_MOCKS=true

# --- Dynatrace ---
DT_TENANT_URL=
DT_API_TOKEN=
DT_MCP_URL=
DT_MCP_CLIENT_ID=
DT_MCP_CLIENT_SECRET=

# --- Google Cloud / Gemini ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west2
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-2.0-flash

# --- Behaviour ---
AUTO_APPROVE_LOW_RISK=false
MAX_AUTO_APPROVE_SEVERITY=LOW
CORS_ORIGINS=*
