# Copy to backend/.env and fill in to enable live mode. Leave unset for mocks.
USE_MOCKS=true

# --- Dynatrace ---
DT_TENANT_URL=
DT_API_TOKEN=
DT_MCP_URL=
DT_MCP_CLIENT_ID=
DT_MCP_CLIENT_SECRET=

# --- Google Cloud / Gemini ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west2
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-2.0-flash

# --- Behaviour ---
AUTO_APPROVE_LOW_RISK=false
MAX_AUTO_APPROVE_SEVERITY=LOW
CORS_ORIGINS=*

# --- Persistence (Phase 2) ---
# Empty => in-memory. Example durable store:
# DATABASE_URL=sqlite+aiosqlite:///stadiumpulse.db
DATABASE_URL=

# --- Auth (Phase 2) ---
AUTH_ENABLED=false
API_KEY=
JWT_SECRET=

# --- RBAC / rate limiting (Phase 3) ---
# Roles granted to a valid API key (comma-separated): viewer,operator,responder,admin
API_KEY_ROLES=admin
# JWT claim carrying role names (list or comma string)
JWT_ROLES_CLAIM=roles
# Token-bucket rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=120
# Webhook delivery timeout (seconds)
WEBHOOK_TIMEOUT_SECONDS=5.0

# --- Phase 4 notes ---
# Outbox/relay, idempotency, optimistic concurrency, audit log and W3C trace
# propagation are always on; no extra configuration required. Webhook retry uses
# WEBHOOK_TIMEOUT_SECONDS (above) per attempt.

# --- OIDC SSO (optional; enables the "Sign in with SSO" button) ---
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=stadiumpulse
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://your-app/api/v1/auth/oidc/callback
# OIDC_ROLES_CLAIM=roles
# OIDC_VENUES_CLAIM=venues
# OIDC_SCOPES=openid profile email
# Strict by default: verifies ID-token signature (JWKS) + iss/aud/exp/nonce.
# Set false ONLY for a local unsigned demo IdP.
# OIDC_VERIFY_SIGNATURE=true

# --- Dynatrace management-zone → venue mapping (entity-keyed domain scoping) ---
# Map a Dynatrace management zone (or entity tag value) to a venue id, so SLO/
# analytics/entities partition by venue from real tenant metadata.
# VENUE_ZONE_MAP=Arena North=venue_arena_north,Olympic Park=venue_olympic_park
# VENUE_ZONE_TAG_KEY=mz

# --- Persistence ---
# When set, incidents/remediations/audit AND refresh tokens use SQL (any
# SQLAlchemy async URL). Unset → in-memory (demo).
# DATABASE_URL=sqlite+aiosqlite:///./stadiumpulse.db

# --- Round 8: token hygiene + live zones ---
# How often (seconds) to sweep expired/consumed/revoked refresh tokens.
# REFRESH_PRUNE_INTERVAL_SECONDS=3600
# When DT_TENANT_URL + DT_API_TOKEN are set, management zones are pulled live
# from the Dynatrace config API to build the zone→venue map (static VENUE_ZONE_MAP
# still overrides). Refresh tokens are always stored hashed (SHA-256) at rest.

# --- Round 9: auth hardening + auto zone mapping ---
# Strict per-IP limit for /auth/login + /auth/refresh (always on).
# AUTH_RATE_LIMIT_PER_MINUTE=10
# Map management zones to venues by stable zone id (survives renames):
# VENUE_ZONE_ID_MAP=12345=venue_arena_north,67890=venue_olympic_park
# Auth events (login/refresh/reuse/logout) are written to the audit log.

# --- Round 10: multi-instance ---
# Shared backend for cross-instance rate-limiting (and future shared counters).
# When set, the always-on auth limit is global across replicas; unset → in-process.
# REDIS_URL=redis://localhost:6379/0
# The Security page (auth audit trail) is served from GET /api/v1/auth/events
# (admin-only). Auth events are durable when DATABASE_URL is set.

# --- Round 11: security hardening + multi-instance ---
# SECURITY_HEADERS_ENABLED=true        # CSP/X-Frame-Options/nosniff/Referrer (default on)
# HSTS_ENABLED=false                   # enable only when served over TLS
# CSP_OVERRIDE=                        # custom Content-Security-Policy string
# CSRF_ENABLED=false                   # enable for cookie-auth deployments (double-submit)
# COOKIE_SECURE=false                  # set true behind TLS
# Compose multi-instance demo: see docker-compose.yml + scripts/verify_multi_instance.sh
