# Copy to backend/.env and fill in to enable live mode. Leave unset for mocks.
USE_MOCKS=true

# --- Dynatrace ---
DT_TENANT_URL=
DT_API_TOKEN=
DT_MCP_URL=
DT_MCP_CLIENT_ID=
DT_MCP_CLIENT_SECRET=

# --- Google Cloud / Gemini ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west2
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-2.0-flash

# --- Behaviour ---
AUTO_APPROVE_LOW_RISK=false
MAX_AUTO_APPROVE_SEVERITY=LOW
CORS_ORIGINS=*

# --- Persistence (Phase 2) ---
# Empty => in-memory. Example durable store:
# DATABASE_URL=sqlite+aiosqlite:///stadiumpulse.db
DATABASE_URL=

# --- Auth (Phase 2) ---
AUTH_ENABLED=false
API_KEY=
JWT_SECRET=

# --- RBAC / rate limiting (Phase 3) ---
# Roles granted to a valid API key (comma-separated): viewer,operator,responder,admin
API_KEY_ROLES=admin
# JWT claim carrying role names (list or comma string)
JWT_ROLES_CLAIM=roles
# Token-bucket rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=120
# Webhook delivery timeout (seconds)
WEBHOOK_TIMEOUT_SECONDS=5.0

# --- Phase 4 notes ---
# Outbox/relay, idempotency, optimistic concurrency, audit log and W3C trace
# propagation are always on; no extra configuration required. Webhook retry uses
# WEBHOOK_TIMEOUT_SECONDS (above) per attempt.

# --- OIDC SSO (optional; enables the "Sign in with SSO" button) ---
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=stadiumpulse
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://your-app/api/v1/auth/oidc/callback
# OIDC_ROLES_CLAIM=roles
# OIDC_VENUES_CLAIM=venues
# OIDC_SCOPES=openid profile email
# Strict by default: verifies ID-token signature (JWKS) + iss/aud/exp/nonce.
# Set false ONLY for a local unsigned demo IdP.
# OIDC_VERIFY_SIGNATURE=true
